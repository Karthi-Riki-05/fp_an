# ── Backend environment (copy to .env and fill in) ──────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Database — Postgres with the `public` + `tenant_template` (+ tenant_<id>) schemas.
DATABASE_URL=postgresql://app:app@localhost:5432/fp_analyzer?schema=public

# Redis (sessions, FCM token sets, throttling).
REDIS_URL=redis://localhost:6379

# Auth / cookies.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_IMPERSONATE_TTL=3600
COOKIE_SECRET=change-me-too
COOKIE_DOMAIN=localhost

# CORS — comma-separated allowed origins (frontend URLs).
CORS_ORIGINS=http://localhost:3000,http://localhost:3030

# Public URLs.
APP_URL=http://localhost:3000
# Embedded in generated Andon TV-board links (Sprint 3/4).
PUBLIC_APP_URL=https://app.fpanalyzer.se

# MQTT broker (machine telemetry).
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_URL_PUBLIC=mqtt://localhost:1883
MQTT_CLIENT_ID=fp-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TLS_VERIFY=true
# MQTT_CA_FILE=/path/to/ca.pem

# Mail (alerts / password reset).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@fpanalyzer.se
MAIL_FROM_NAME=FP Analyzer

# Storage (uploads / icons).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE=/uploads
# ICONS_DIR=./public/icons

# Rate limiting.
THROTTLE_DEFAULT_TTL=60
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_LIMIT=20
