{
  "name": "@fp-analyzer/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "FP Analyzer frontend — Next.js 14 App Router / Ant Design 5 / next-intl. No Tailwind (AntD is the design system).",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "playwright test",
    "test:public": "playwright test tests/public.spec.ts",
    "test:user": "playwright test tests/user.spec.ts",
    "test:admin": "playwright test tests/admin.spec.ts",
    "test:mobile": "playwright test --project=mobile-admin --project=mobile-user --project=public-mobile",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@ant-design/nextjs-registry": "^1.0.1",
    "@ant-design/plots": "^2.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "antd": "^5.20.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "highcharts": "^12.6.0",
    "highcharts-react-official": "^3.2.3",
    "next": "^14.2.10",
    "next-intl": "^3.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.10",
    "typescript": "^5.5.4"
  }
}
