{
  "name": "@fp-analyzer/backend",
  "version": "0.1.0",
  "private": true,
  "description": "FP Analyzer backend — Express.js / Node 20 LTS / PostgreSQL 16 (schema-per-tenant).",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate --accept-data-loss",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "db:bootstrap": "prisma db push --skip-generate --accept-data-loss && node prisma/seed.js",
    "test": "jest --config=test/jest.config.js --runInBand --forceExit",
    "test:e2e": "jest --config=test/jest.config.js --runInBand --forceExit"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "nodemailer": "^6.9.14",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2"
  }
}
