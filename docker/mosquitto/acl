# Mosquitto ACL file
# Format: user <username> / topic <permission> <topic-pattern>
#
# Backend superuser — can read/write everything under fp/#.
# Username must match MQTT_USERNAME in .env (/ .env.production on the server).
user fpanalyzer-mqtt-u1
topic readwrite fp/#

# Per-device entries are added here by the provisioning process.
# Each provisioned device gets two rules (generated by the provision-mqtt API endpoint):
#
#   POST /api/v1/admin/iot/units/{machineId}/provision-mqtt
#
# After receiving credentials from the API, add the following two lines and
# reload the broker (docker kill --signal=SIGHUP <mqtt-container>):
#
# user machine-{tenantId}-{machineId}
# topic write fp/v1/{tenantId}/machine/{machineId}/#
# topic read  fp/v1/{tenantId}/machine/{machineId}/#
