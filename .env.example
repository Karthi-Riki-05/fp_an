# FP Analyzer — environment variable template.
# Copy to .env.local (dev) or .env.production (prod). Never commit real values.
# All vars documented in MIGRATION_NOTES.md §12 + §17 (R6 timezone) + §16 (R5 polling).

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DEFAULT_LOCALE=sv
FALLBACK_LOCALE=en

# =============================================================================
# Default timezone (R6) — applied at app boot when no tenant context exists.
# Per-tenant TZ stored in public.tenants.timezone (default 'Europe/Stockholm').
# =============================================================================
DEFAULT_TIMEZONE=Europe/Stockholm
TZ=UTC                      # the container's clock; storage is always UTC.

# =============================================================================
# JWT — three secrets, three audiences (A4)
# =============================================================================
JWT_ACCESS_SECRET=          # Web access token (cookie). 15 min.
JWT_REFRESH_SECRET=         # Web refresh token (cookie). 7 days.
JWT_DEVICE_SECRET=          # IoT device bearer token. 365 days. NEVER share with web secrets.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_DEVICE_TTL=365d

# =============================================================================
# Database (Postgres) — schema-per-tenant per MIGRATION_NOTES §11.
# =============================================================================
POSTGRES_DB=fp_analyzer
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@postgres:5432/fp_analyzer?schema=public
DATABASE_TEMPLATE_SCHEMA=tenant_template

# =============================================================================
# Machine data partitioning (A3) — see §4.6
# =============================================================================
MACHINE_DATA_RETENTION_MONTHS=24    # 0 = keep forever
MACHINE_DATA_PARTITION_BUFFER=2     # months to maintain ahead of current

# =============================================================================
# Bull Board UI gate (A10) — off by default, only for local debugging.
# =============================================================================
BULLBOARD_ENABLED=false

# =============================================================================
# Redis (cache + sessions + BullMQ)
# =============================================================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# =============================================================================
# Mail
# =============================================================================
MAIL_HOST=smtp.office365.com        # in dev: mailhog
MAIL_PORT=587                       # in dev: 1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=info@fpanalyzer.se
MAIL_FROM_NAME="FP Analyzer"

# =============================================================================
# File storage (local disk in dev, S3 in prod)
# =============================================================================
STORAGE_DRIVER=local                # local | s3
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=eu-north-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_FILE_SIZE=8388608               # 8 MB. Legacy was 7888000 (~7.5 MB); rounded up.

# =============================================================================
# Recaptcha v3
# =============================================================================
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_THRESHOLD=0.5

# =============================================================================
# Social OAuth — 5 providers by default. Bitbucket commented out per B4
# (operator confirms via SELECT COUNT(*) FROM social_logins WHERE provider='bitbucket').
# =============================================================================
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URL=
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=
# BITBUCKET_REDIRECT_URL=

# =============================================================================
# Firebase Cloud Messaging
# =============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =============================================================================
# Throttling
# =============================================================================
THROTTLE_DEFAULT_TTL=60
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_AUTH_LIMIT=5
THROTTLE_IOT_LIMIT=600

# =============================================================================
# Frontend polling intervals (R5) — bumped vs v1; see §16.
# Per-page configurable; SSE replaces this when load data justifies it.
# =============================================================================
NEXT_PUBLIC_POLL_INTERVAL_FLOW_MONITOR_MS=10000
NEXT_PUBLIC_POLL_INTERVAL_LOSS_MONITOR_MS=15000
NEXT_PUBLIC_POLL_INTERVAL_UNITS_MS=20000
NEXT_PUBLIC_POLL_INTERVAL_MACHINE_STATUS_MS=10000
NEXT_PUBLIC_POLL_INTERVAL_DASHBOARD_MS=30000

# =============================================================================
# Monitoring (optional)
# =============================================================================
GRAPH_URL=
GRAPH_KEY=

# =============================================================================
# Super Admin seed (consumed by prisma/seed.ts on first run only)
# =============================================================================
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# =============================================================================
# Maintenance
# =============================================================================
MAINTENANCE_MODE=false

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
