# ── Frontend environment (copy to .env.local and fill in) ───────────────────

# Backend ORIGIN (NOT including /api/v1 — the api-client appends /api/v1 itself).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Socket.io server origin (machine status + public /andon namespace).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Public app URL (used when building absolute links, e.g. Andon TV links).
NEXT_PUBLIC_APP_URL=https://app.fpanalyzer.se

# Static asset base (uploaded images / icons), if served from a separate host.
NEXT_PUBLIC_ASSET_BASE=http://localhost:4000/uploads

# Optional: surfaced in some diagnostics views.
# NEXT_PUBLIC_DB_HOST=localhost
